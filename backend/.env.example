# NestJS API — Tabasamu ecommerce backend
#
# Ports: Next storefront 3000 · Nest API 3001 · Medusa (interim) 9000

PORT=3001
NODE_ENV=development

# Dedicated DB — do not use Medusa's `medusa` database.
#
# Host (against Medusa Compose Postgres on 5434, after CREATE DATABASE tabasamu):
#   DATABASE_URL=postgresql://medusa:medusa@localhost:5434/tabasamu?schema=public
#
# docker-compose.dev.yml (lean Nest stack — recommended for Phase 1):
#   DATABASE_URL=postgresql://tabasamu:tabasamu@localhost:5435/tabasamu?schema=public
DATABASE_URL=postgresql://tabasamu:tabasamu@localhost:5435/tabasamu?schema=public

# Required for /v1/admin/* writes
ADMIN_API_KEY=dev-admin-key-change-me
