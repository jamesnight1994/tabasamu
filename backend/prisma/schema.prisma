generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  draft
  active
  archived
}

enum ImageRole {
  hero
  packshot
  lifestyle
  label
  process
}

model Product {
  id                    String         @id @default(cuid())
  slug                  String         @unique
  name                  String
  flavour               String
  position              Int            @default(0)
  status                ProductStatus  @default(draft)
  subscriptionEligible  Boolean        @default(true) @map("subscription_eligible")
  descriptor            String?
  base                  String?
  forwardNote           String?        @map("forward_note")
  seo                   Json?
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  variants Variant[]
  images   ProductImage[]

  @@map("products")
}

model Variant {
  id           String  @id @default(cuid())
  productId    String  @map("product_id")
  sku          String  @unique
  sizeCode     String  @default("1L") @map("size_code")
  millilitres  Int     @default(1000)
  priceAmount  Int?    @map("price_amount") // minor units (KES cents); demo until D-14
  currency     String  @default("KES")
  compareAt    Int?    @map("compare_at")
  active       Boolean @default(true)
  stockOnHand  Int     @default(0) @map("stock_on_hand")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("variants")
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String    @map("product_id")
  src       String
  alt       String
  width     Int       @default(800)
  height    Int       @default(1000)
  role      ImageRole @default(packshot)
  sortOrder Int       @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}
