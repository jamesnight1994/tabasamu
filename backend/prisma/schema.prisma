generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  draft
  active
  archived
}

enum ImageRole {
  hero
  packshot
  lifestyle
  label
  process
}

/// Serialized stock-unit lifecycle (QR per bottle). See #19/#20.
/// Status machine: printed → in_stock → sold; printed|in_stock → void.
/// sold and void are terminal (returns get a NEW code, not reactivation).
enum StockUnitStatus {
  printed
  in_stock
  sold
  void
}

model Product {
  id                    String         @id @default(cuid())
  slug                  String         @unique
  name                  String
  flavour               String
  position              Int            @default(0)
  status                ProductStatus  @default(draft)
  subscriptionEligible  Boolean        @default(true) @map("subscription_eligible")
  descriptor            String?
  base                  String?
  forwardNote           String?        @map("forward_note")
  seo                   Json?
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  variants Variant[]
  images   ProductImage[]

  @@map("products")
}

model Variant {
  id           String  @id @default(cuid())
  productId    String  @map("product_id")
  sku          String  @unique
  sizeCode     String  @default("1L") @map("size_code")
  millilitres  Int     @default(1000)
  priceAmount  Int?    @map("price_amount") // minor units (KES cents); demo until D-14
  currency     String  @default("KES")
  compareAt    Int?    @map("compare_at")
  active       Boolean @default(true)
  stockOnHand  Int     @default(0) @map("stock_on_hand")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockUnits StockUnit[]

  @@index([productId])
  @@map("variants")
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String    @map("product_id")
  src       String
  alt       String
  width     Int       @default(800)
  height    Int       @default(1000)
  role      ImageRole @default(packshot)
  sortOrder Int       @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

/// One physical bottle = one serialized unit with an opaque QR `code`.
/// `variantId` is null until activation binds a SKU (#22). `batchId` groups
/// a print run (#21). `variant.stockOnHand` is kept in sync with the count of
/// this variant's `in_stock` units — the unit ledger is the source of truth.
model StockUnit {
  id          String          @id @default(cuid())
  code        String          @unique
  status      StockUnitStatus @default(printed)
  variantId   String?         @map("variant_id")
  batchId     String?         @map("batch_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  activatedAt DateTime?       @map("activated_at")
  soldAt      DateTime?       @map("sold_at")

  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([status])
  @@index([batchId])
  @@map("stock_units")
}
