# Medusa backend — copy to `.env` in this directory.
#
# Local Docker Compose defaults (see repo root docker-compose.yml):
# Host ports: Postgres 5434, Redis 6382 (container-internal ports unchanged).

DATABASE_URL=postgres://medusa:medusa@localhost:5434/medusa
# Host tools / Medusa on the host: Compose publishes Redis on 6382 (local 6379 stays free).
# Inside docker compose, the medusa service uses redis://redis:6379 automatically.
REDIS_URL=redis://localhost:6382

JWT_SECRET=supersecret_jwt_change_me
COOKIE_SECRET=supersecret_cookie_change_me

STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:3000,http://localhost:5173

# After `yarn seed`, copy the publishable key from Medusa Admin
# (Settings → Publishable API Keys) into the Next.js `.env.local` as well.
# MEDUSA_PUBLISHABLE_KEY=

PORT=9000
