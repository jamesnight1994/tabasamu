# Production / VM runtime env — copy to repo-root `.env` on the server (gitignored).
# Portainer: edit these on the stack → Recreate the container (no image rebuild).
#
#   cp compose/.env.prod.example /opt/tabasamu/.env

# --- Public config (frontend — written to /runtime-env.js on container start) ---
TABASAMU_APP_ENV=staging
TABASAMU_PUBLIC_APP_URL=http://169.58.241.255:3000
TABASAMU_PUBLIC_API_URL=http://169.58.241.255:3001
TABASAMU_ADAPTERS=http
# TABASAMU_ANALYTICS_ENABLED=false
# TABASAMU_LOG_LEVEL=info

# --- Secrets / routing (runtime — Portainer Recreate) ---
ADMIN_API_KEY=change-me-to-a-strong-secret
NEST_HOST_PORT=3001
# DATABASE_URL is set inside compose to the postgres service; override only if needed.
