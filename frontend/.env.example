# =====================================================================
# TABASAMU SIPS — ENVIRONMENT TEMPLATE
#
# Copy to `.env.local`. NEVER commit `.env.local`.
#
# ⚠ EVERY SECRET BELOW IS A PLACEHOLDER. None has been supplied by the
#   client, and none is invented. Each is traceable to an open decision.
# =====================================================================

# ---------- CLIENT (safe — bundled into the browser) ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# 'mock' until a backend exists.
# ⚠ Flipping this to 'http' IS the Gate G2 handover. The full flow suite must
#   pass against BOTH values with zero changes above the adapter layer.
NEXT_PUBLIC_ADAPTERS=mock

# Nest product API (Phase 1 catalogue). Point here when ADAPTERS=http.
# Medusa (:9000) remains interim for cart/auth until later Nest phases.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Admin staff auth API base (defaults to NEXT_PUBLIC_API_URL when unset).
# Login endpoint used by /admin/login (see src/lib/admin/api-paths.ts):
#   POST {NEXT_PUBLIC_ADMIN_AUTH_URL}/custom_auth/login/user
#   Body: { username: email, password }
# Full local URL: http://localhost:3001/custom_auth/login/user
# Note: Nest does not implement this route yet (Phase 1 is API-key admin only).
# Point at your legacy auth service until Nest staff login ships.
NEXT_PUBLIC_ADMIN_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_AUTH_DEBUG=false

# Dev-only admin bypass (synthetic login + X-Admin-Api-Key for Nest CRUD).
# See docs/admin/dev-auth-bypass-spec.md — never enable in production.
# NEXT_PUBLIC_ADMIN_AUTH_BYPASS=true
# NEXT_PUBLIC_ADMIN_API_KEY=dev-admin-key-change-me

# Admin shell topnav background (hex). Default: #DFE0E0
NEXT_PUBLIC_ADMIN_TOPNAV_COLOR=#DFE0E0
# Profile icon button background (hex). Default: topnav color darkened 25% (#A7A8A8)
# NEXT_PUBLIC_ADMIN_TOPNAV_PROFILE_BG=#A7A8A8
# Sidenav active link accent (hex). Default: blue-600 (#2563EB)
# NEXT_PUBLIC_ADMIN_SIDENAV_ACTIVE_COLOR=#2563EB
# Dashboard tab underline + active icon (hex). Default: sidenav active color
# NEXT_PUBLIC_ADMIN_DASHBOARD_TAB_ACTIVE_COLOR=#2563EB
# Optional server-side override (Docker): NEST_API_URL=http://host.docker.internal:3001
# Legacy Medusa publishable key — unused for Nest product reads; keep if cart still hits Medusa
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# ⚠ Analytics has TWO gates: this flag AND the customer's opt-in consent
#   (deny-by-default, Kenya DPA 2019 — D-43). Both must be true before any
#   event is sent. Setting this to 'true' does NOT enable tracking on its own.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_LOG_LEVEL=info


# =====================================================================
# SERVER ONLY — NEVER PREFIX THESE WITH NEXT_PUBLIC_
#
# `serverEnv()` throws if called in the browser, and
# `npm run lint:secrets` scans the built bundle and fails on a hit. [NN-03]
# =====================================================================

# ---------- M-PESA / Daraja ----------  ⛔ D-31, D-32
# The paybill/till and the Daraja app credentials have NOT been supplied.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=

# ---------- CARD RAIL ----------  ⛔ D-34, D-35
# ⚠ D-35 IS UNRESOLVED AND IS A HARD DEPENDENCY.
#   Stripe may not be able to settle KES for a Kenyan entity. If it cannot, the
#   card rail must become Flutterwave / Pesapal / DPO — which changes the
#   integration entirely. Until this is answered, CARD_PROVIDER stays 'none'
#   and the card option is disabled in the UI.
CARD_PROVIDER=none
CARD_PUBLIC_KEY=
CARD_SECRET_KEY=
CARD_WEBHOOK_SECRET=

# ---------- NOTIFICATIONS ----------  ⛔ D-40, D-41
# ⚠ In Kenya, SMS is the EXPECTED order-confirmation channel, more than email.
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Contact form (Gmail SMTP) — server-only. Use a Google App Password, not your login password.
# EMAIL_USER=
# EMAIL_PASS=
# Optional inbox override (defaults to EMAIL_USER)
# CONTACT_INBOX_TO=owagaantony@gmail.com
SMS_PROVIDER=
SMS_API_KEY=

# ---------- BACKEND ----------  (Gate G2 / Medusa)
API_BASE_URL=
API_SERVICE_TOKEN=
DATABASE_URL=
SESSION_SECRET=
# Docker-internal Medusa URL (server-side). Browser uses NEXT_PUBLIC_API_URL.
MEDUSA_BACKEND_URL=http://localhost:9000
# Optional server fallback if not using NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY
MEDUSA_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────
# PHASE 6 — AUTHENTICATION  ⛔ D-53 / D-54 / D-55 (all unconfirmed)
# The frontend is provider-neutral; these are placeholders for whichever
# mechanism the client chooses. NONE is connected. [NN-04]
# ─────────────────────────────────────────────────────────────
# ⛔ D-53 — auth mechanism/provider. If a managed provider is chosen, its keys
#           go here (server-side only). If bespoke, the session-signing secret.
AUTH_PROVIDER=none
AUTH_SESSION_SECRET=
# ⛔ D-55 — session lifetime (minutes) and refresh model.
AUTH_SESSION_TTL_MINUTES=30
# ⛔ D-54 — email verification + password-reset link delivery (ties to D-40).
AUTH_EMAIL_FROM=
AUTH_VERIFICATION_TOKEN_TTL_HOURS=24
AUTH_RESET_TOKEN_TTL_HOURS=1
# ⛔ D-56 — social login, only if separately approved. Not built.
AUTH_GOOGLE_CLIENT_ID=
AUTH_APPLE_CLIENT_ID=
