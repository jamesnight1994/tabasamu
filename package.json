{
  "name": "tabasamu",
  "version": "0.1.0",
  "private": true,
  "description": "Tabasamu monorepo — frontend (Next), backend (NestJS), commerce (Medusa interim)",
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "front:dev": "yarn --cwd frontend dev",
    "front:build": "yarn --cwd frontend build",
    "front:start": "yarn --cwd frontend start",
    "front:verify": "yarn --cwd frontend verify",
    "front:test": "yarn --cwd frontend test",
    "back:dev": "yarn --cwd backend start:dev",
    "back:build": "yarn --cwd backend build",
    "back:start": "yarn --cwd backend start:prod",
    "back:migrate": "yarn --cwd backend prisma:migrate",
    "back:seed": "yarn --cwd backend prisma:seed",
    "medusa": "yarn --cwd commerce medusa",
    "commerce:dev": "yarn --cwd commerce backend:dev",
    "commerce:seed": "yarn --cwd commerce backend:seed",
    "commerce:user": "yarn --cwd commerce backend:user",
    "commerce:migrate": "yarn --cwd commerce backend:migrate",
    "docker": "./scripts/docker-yarn.sh",
    "docker:medusa": "./scripts/docker-yarn.sh -s medusa",
    "docker:app": "./scripts/docker-yarn.sh -s app",
    "docker:dev": "./scripts/docker-dev.sh",
    "docker:dev:down": "./scripts/docker-dev.sh down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "portainer": "./scripts/docker-portainer.sh",
    "portainer:down": "./scripts/docker-portainer.sh down",
    "server:ssh": "./scripts/ssh-server.sh"
  }
}
