{
  "name": "tabasamu",
  "version": "0.1.0",
  "private": true,
  "description": "Tabasamu monorepo — frontend (Next), backend (NestJS), commerce (Medusa interim)",
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "front:dev": "yarn --cwd frontend dev",
    "front:build": "yarn --cwd frontend build",
    "front:start": "yarn --cwd frontend start",
    "front:verify": "yarn --cwd frontend verify",
    "front:test": "yarn --cwd frontend test",
    "back:dev": "yarn --cwd backend start:dev",
    "back:build": "yarn --cwd backend build",
    "back:start": "yarn --cwd backend start:prod",
    "back:migrate": "yarn --cwd backend prisma:migrate",
    "back:seed": "yarn --cwd backend prisma:seed",
    "portainer:reset": "./scripts/portainer-reset.sh",
    "server:ssh": "./scripts/ssh-server.sh",
    "deploy:vm": "./scripts/deploy-vm.sh",
    "smoke:vm": "./scripts/smoke-vm.sh"
  }
}
